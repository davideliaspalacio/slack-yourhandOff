{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["src/**", "pyproject.toml", "uv.lock", "Dockerfile", "railway.digest.json"]
  },
  "deploy": {
    "startCommand": "handoff digest",
    "cronSchedule": "0 13 * * *",
    "numReplicas": 1,
    "restartPolicyType": "NEVER"
  }
}
