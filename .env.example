# Supabase local — sale de `supabase status`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# SearXNG local (docker-compose.searxng.yml)
SEARXNG_URL=http://127.0.0.1:8080
# Clave de sesión de SearXNG — generar con: openssl rand -hex 32
SEARXNG_SECRET=

# Serper (resultados de Google) — opcional. Si hay clave, se usa antes que SearXNG.
# ~$1 por 1.000 búsquedas en el paquete más pequeño, menos por volumen:
# contrastar el precio con la factura en serper.dev.
SERPER_API_KEY=
PRICE_SERPER_PER_QUERY=0.001

# Langfuse Cloud — opcional; sin claves, el trazado queda desactivado
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Región del proyecto de Langfuse: https://cloud.langfuse.com (Europa)
# o https://us.cloud.langfuse.com (EE. UU.). Si no coincide, las trazas no llegan.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Precios USD por millón de tokens de gpt-4.1 — verificados contra
# developers.openai.com/api/docs/pricing el 2026-09-10
PRICE_INPUT_PER_M=2.00
PRICE_CACHED_INPUT_PER_M=0.50
PRICE_OUTPUT_PER_M=8.00

# Guardarraíles
HTTP_TIMEOUT_SECONDS=30
# Los topes de presupuesto NO viven aquí: están en la tabla `config` de
# Supabase para poder cambiarlos sin redeploy, que es lo que pide el spec.
#   update config set value = '200'::jsonb where key = 'monthly_budget_usd';

# Slack del Founders Club — token de USUARIO (xoxp) con scopes de solo lectura:
# channels:history, channels:read, groups:history, groups:read, users:read,
# users:read.email. El agente nunca escribe allí.
SLACK_USER_TOKEN=
# IDs de los canales a vigilar, separados por comas (C0123,C0456)
SLACK_CHANNEL_IDS=
# Primera lectura de un canal: cuántas horas hacia atrás. Sin backfill.
SLACK_LOOKBACK_HOURS=1
SLACK_POLL_SECONDS=3600

# Alertas operativas (token caído, parada del sistema) — webhook entrante del
# Slack DE HANDOFF, nunca del Founders Club. Opcional.
HANDOFF_ALERT_WEBHOOK_URL=

# Slack DE HANDOFF — token de BOT (xoxb) propio, distinto del de lectura del
# Founders Club. Es el único credential con el que el agente escribe: publica
# y actualiza tarjetas en HANDOFF_SLACK_CHANNEL_ID, y se niega si ese canal
# coincide con uno de SLACK_CHANNEL_IDS.
HANDOFF_SLACK_BOT_TOKEN=
# Canal de Handoff donde se publican las tarjetas de alerta.
HANDOFF_SLACK_CHANNEL_ID=
# Firma de las peticiones entrantes de Slack (botones de la tarjeta, eventos).
SLACK_SIGNING_SECRET=

# Twilio — SMS para la banda alta, además de la tarjeta de Slack. Opcional:
# sin credenciales, sms.maybe_send falla al enviar como cualquier otro fallo
# de entrega (se registra y no tumba el research).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número remitente verificado en Twilio.
TWILIO_FROM=
# Número de Anthony, el único destinatario.
TWILIO_TO=
# Precio en USD por SMS saliente — verificar contra twilio.com/en-us/sms/pricing
PRICE_TWILIO_PER_SMS=0.0079

# Resend — email diario de resumen (miembros nuevos, señales de banda baja y
# gasto del día). Opcional: sin RESEND_API_KEY, DIGEST_FROM o DIGEST_TO,
# digest.send_daily no hace nada (se registra en el log, sin fila en el
# ledger). Corre como un segundo servicio programado, ver railway.digest.json.
RESEND_API_KEY=
# Remitente verificado en Resend.
DIGEST_FROM=
# Destinatarios del resumen, separados por comas (Anthony, normalmente).
DIGEST_TO=
# Precio en USD por email — verificar contra resend.com/pricing
PRICE_RESEND_PER_EMAIL=0.0

# Webhook privado de Handoff que enriquece una empresa a partir de su dominio
# (POST {"companyUrl": "https://..."}). Repo PÚBLICO: nunca comitear la URL
# real. Sin ella, el research sigue sin datos de proveedor (ver
# tools/enrichment.py). Puede tardar hasta ~100s o llevar días caído.
ENRICHMENT_WEBHOOK_URL=
ENRICHMENT_TIMEOUT_SECONDS=120
# El flujo real llama a GPT-4.1 más un proveedor de datos de empresa; coste
# desconocido por ahora, de ahí el 0.0 -- corregir en cuanto se sepa.
PRICE_ENRICHMENT_PER_CALL=0.0

# URL pública del panel (sin barra final) -- la tarjeta de Slack la usa para
# el botón "Open in panel" hacia personas/<id>. Sin ella, el botón no aparece.
PANEL_URL=

# Unipile -- cuenta de Sales Navigator de Anthony, SOLO LECTURA (radar de
# cuentas objetivo, ver tools/unipile.py). La clave da acceso también a
# buzones conectados: nunca comitearla. Sin estas tres, nada toca LinkedIn.
# Los topes diarios y el horario viven en la tabla config (unipile_*).
UNIPILE_API_KEY=
# host:puerto que muestra el dashboard de Unipile, p. ej. api4.unipile.com:13460
UNIPILE_DSN=
UNIPILE_ACCOUNT_ID=
