{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "Dockerfile",
      "panel/**",
      "pyproject.toml",
      "railway.json",
      "src/**",
      "uv.lock"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 300,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
